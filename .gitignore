# Secrets et réglages locaux
.env
.env.*
*.local.json
.claude/settings.local.json

# Divers
node_modules/
.DS_Store
*.log

# Site (Next.js) : builds et caches
site/.next/
site/out/
site/*.tsbuildinfo
site/next-env.d.ts
